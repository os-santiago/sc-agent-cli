            "context": "CodeQL Security Analysis",
            "integration_id": 15368
          },
          {
            "context": "Data Exfiltration Prevention",
            "integration_id": 15368
          },
          {
            "context": "Dependency Review",
            "integration_id": 15368
          },
          {
            "context": "Dependency Vulnerability Scan",
            "integration_id": 15368
          },
          {
            "context": "License Compliance Check",
            "integration_id": 15368
          },
          {
            "context": "Malware & Backdoor Detection",
            "integration_id": 15368
          },
          {
            "context": "Secret Scanning",
            "integration_id": 15368
          },
          {
            "context": "Static Code Analysis (Bandit)",
            "integration_id": 15368
          },
          {
            "context": "Supply Chain Security",
            "integration_id": 15368
          },
          {
            "context": "Validate PR title",
            "integration_id": 15368
          },
